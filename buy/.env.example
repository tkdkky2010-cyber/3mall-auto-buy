# 카드사별 간편비밀번호 6자리 (앱마다 동일/다름은 사용자 결정)
SAMSUNG_PAY_PIN=
LOTTE_PAY_PIN=
KB_PAY_PIN=
HANA_PAY_PIN=
NH_PAY_PIN=
HYUNDAI_PAY_PIN=
KAKAO_PAY_PIN=
TOSS_PAY_PIN=

# 결제수단 강제 지정 (override) — 비우면 결제 페이지 캐러셀에서 자동 판독
# 카드: "삼성카드"/"현대카드"/"KB국민카드"/"하나카드"/"롯데카드"/"NH농협카드"/"비씨카드(페이북)"/"신한카드"
# 페이: "카카오페이"/"토스페이"
TODAY_BRAND=

# Chrome / CDP 설정 (run_cart.py와 동일 — port 9222로 떠 있어야 함)
CDP_PORT=9222

# Android (Phase 3-B에서 사용 예정)
ADB_DEVICE=

# Phase 3-A 안전장치: True면 결제하기 클릭 후 7자리 코드만 추출 (실제 폰 결제 X)
DRY_PAYMENT=true
